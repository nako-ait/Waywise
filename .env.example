# Compose cloud settings. Copy to .env or use configure_cloud_amap.py.
# JS API Key is public and enters the browser bundle.
VITE_AMAP_JS_KEY=
# JS security code is supplied only to the Nginx container at runtime.
AMAP_SECURITY_CODE=
# Optional public HTTPS entrance; configure_public_access.py sets these.
PUBLIC_IP=
DEMO_PASSWORD_HASH=
COMPOSE_PROFILES=
