# ============================================================
# 后端环境变量模板 —— 复制为 .env 后填值
#   Windows:  copy .env.example .env
# ============================================================

# ---- 高德「Web 服务」Key（距离矩阵 / 路径规划 / 地理编码）----
# 不填也能量：会自动降级为「离线估算」（直线距离 × 道路系数），
# 页面上会如实标注 dataSource=offline-estimate。
AMAP_WEB_KEY=

# ---- LLM（模块 4 AI 能力，可留空）----
# 留空时后端自动走内置规则解析（nlp_rules.py），功能不会崩，只是没有大模型润色。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- 存储 / 求解器 ----
DATA_DIR=./data
AMAP_CACHE_TTL_HOURS=168
SOLVER_TIME_LIMIT_S=1.2
SOLVER_PROBE_TIME_LIMIT_S=0.4
