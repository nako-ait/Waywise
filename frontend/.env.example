# ============================================================
# 前端环境变量模板 —— 复制为 .env.local 后填值
#   注意：Vite 只在「启动时」读取 .env.*，改完必须重启 pnpm dev
# ============================================================

# 高德「Web端 (JS API)」Key —— 地图显示必需，暴露在浏览器里是正常设计
VITE_AMAP_JS_KEY=

# 若在高德控制台为该 Key 开启了「安全密钥」，这里填安全密钥（仅本地调试用）
VITE_AMAP_SECURITY_CODE=

# 后端地址（默认值即可）
VITE_API_BASE=http://127.0.0.1:8000
